{
  "components": {
    "schemas": {
      "BasketLineIssue": {
        "description": "Why a basket line was rejected.",
        "properties": {
          "code": {
            "description": "One of: item_not_found, item_not_in_merchant, item_unavailable, option_group_not_found, option_not_found, option_unavailable, too_few_options, too_many_options, required_group_missing",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "item_id": {
            "title": "Item Id",
            "type": "string"
          },
          "line_index": {
            "description": "Zero-based index of the offending line",
            "title": "Line Index",
            "type": "integer"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "line_index",
          "item_id",
          "code",
          "message"
        ],
        "title": "BasketLineIssue",
        "type": "object"
      },
      "BasketLineRequest": {
        "description": "One line of a basket to validate and price.",
        "properties": {
          "item_id": {
            "title": "Item Id",
            "type": "string"
          },
          "notes": {
            "anyOf": [
              {
                "maxLength": 280,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "quantity": {
            "default": 1,
            "description": "Number of units",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Quantity",
            "type": "integer"
          },
          "selections": {
            "items": {
              "$ref": "#/components/schemas/BasketSelection"
            },
            "maxItems": 20,
            "title": "Selections",
            "type": "array"
          }
        },
        "required": [
          "item_id"
        ],
        "title": "BasketLineRequest",
        "type": "object"
      },
      "BasketSelection": {
        "description": "The options chosen for one basket line.",
        "properties": {
          "group_id": {
            "title": "Group Id",
            "type": "string"
          },
          "option_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Option Ids",
            "type": "array"
          }
        },
        "required": [
          "group_id",
          "option_ids"
        ],
        "title": "BasketSelection",
        "type": "object"
      },
      "BasketValidationRequest": {
        "description": "A basket to validate against a merchant's catalogue.",
        "examples": [
          {
            "lines": [
              {
                "item_id": "itm_01J9Z8XQF3K7M2P4R6T8V0W1Y3",
                "notes": "No coriander",
                "quantity": 2,
                "selections": [
                  {
                    "group_id": "opg_01J9Z8XQF3K7M2P4R6T8V0W1Y4",
                    "option_ids": [
                      "opt_01J9Z8XQF3K7M2P4R6T8V0W1Y5"
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "properties": {
          "lines": {
            "items": {
              "$ref": "#/components/schemas/BasketLineRequest"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Lines",
            "type": "array"
          }
        },
        "required": [
          "lines"
        ],
        "title": "BasketValidationRequest",
        "type": "object"
      },
      "BasketValidationResponse": {
        "description": "The result of validating a basket.\n\n``valid`` is false when any line has an issue. Lines are reported independently so a\nclient can show every problem at once rather than one per round trip.",
        "examples": [
          {
            "currency": "AED",
            "issues": [],
            "items_amount": "82.00",
            "lines": [],
            "merchant_id": "mch_01J9Z8XQF3K7M2P4R6T8V0W1Y3",
            "valid": true
          }
        ],
        "properties": {
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "issues": {
            "items": {
              "$ref": "#/components/schemas/BasketLineIssue"
            },
            "title": "Issues",
            "type": "array"
          },
          "items_amount": {
            "description": "Sum of all validated line totals; zero when the basket is invalid",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Items Amount",
            "type": "string"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/PricedBasketLine"
            },
            "title": "Lines",
            "type": "array"
          },
          "merchant_id": {
            "title": "Merchant Id",
            "type": "string"
          },
          "valid": {
            "title": "Valid",
            "type": "boolean"
          }
        },
        "required": [
          "merchant_id",
          "valid",
          "currency",
          "items_amount",
          "lines",
          "issues"
        ],
        "title": "BasketValidationResponse",
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "description": "Stable machine-readable error identifier",
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Echoes X-Correlation-Id for support and tracing",
            "title": "Correlation Id"
          },
          "details": {
            "additionalProperties": true,
            "description": "Structured context",
            "title": "Details",
            "type": "object"
          },
          "field_errors": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "title": "Field Errors",
            "type": "array"
          },
          "message": {
            "description": "Human-readable description",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "Error",
        "type": "object"
      },
      "ErrorDetail": {
        "description": "A single field-level validation problem.",
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Machine-readable validation code",
            "title": "Code"
          },
          "field": {
            "description": "Dotted path to the offending field, e.g. 'items.0.quantity'",
            "title": "Field",
            "type": "string"
          },
          "message": {
            "description": "Human-readable explanation",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "description": "The platform-wide error response body.\n\nExample:\n    ```json\n    {\n      \"error\": {\n        \"code\": \"merchant_closed\",\n        \"message\": \"Merchant is not accepting orders right now\",\n        \"details\": {\"opens_at\": \"11:00\"},\n        \"field_errors\": [],\n        \"correlation_id\": \"01J9Z...\"\n      }\n    }\n    ```",
        "examples": [
          {
            "error": {
              "code": "not_found",
              "correlation_id": "01J9Z8XQF3K7M2P4R6T8V0W1Y3",
              "details": {},
              "field_errors": [],
              "message": "Merchant not found"
            }
          }
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "HealthStatus": {
        "description": "Health and readiness probe response.",
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Per-dependency status, e.g. {'database': 'ok'}",
            "title": "Checks",
            "type": "object"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "description": "'ok' or 'degraded'",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "environment"
        ],
        "title": "HealthStatus",
        "type": "object"
      },
      "ItemAvailabilityUpdate": {
