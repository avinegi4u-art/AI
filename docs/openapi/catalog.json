        "type": "object"
      },
      "SelectionType": {
        "description": "How many options a customer may pick from a group.\n\nA single unified model covers both concepts the brief calls out separately: a\n``SINGLE`` group is a variant (size, crust), a ``MULTI`` group is a modifier set\n(extra toppings, sauces). Two near-identical tables would double the validation logic\nfor no gain.",
        "enum": [
          "SINGLE",
          "MULTI"
        ],
        "title": "SelectionType",
        "type": "string"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "JWT access token",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "\nMenus, items and basket validation for the Marsool platform.\n\n`GET /merchants/{id}/menu` returns the whole nested menu in one round trip and is cached in\nRedis, invalidated on any item change so a sold-out item disappears immediately.\n\n`POST /merchants/{id}/basket/validate` is the authority on what a valid basket line is:\nwhich option groups are required, how many options each allows, and what the configured\nline costs. Order creation delegates here rather than reimplementing the rules, so the\norder service cannot accept a line the catalogue would reject.\n",
    "title": "Marsool Catalog Service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/catalog/items/{item_id}": {
      "put": {
        "description": "Partial update. Merchant staff may only edit their own merchants' items.",
        "operationId": "update_item",
        "parameters": [
          {
            "in": "path",
            "name": "item_id",
            "required": true,
            "schema": {
              "title": "Item Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MenuItemUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuItemResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Malformed request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Missing or invalid credentials"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Caller lacks permission"
          },
          "404": {
            "content": {
