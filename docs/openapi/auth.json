{
  "components": {
    "schemas": {
      "AuthenticatedUser": {
        "description": "The authenticated user summary returned alongside tokens.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "phone": {
            "title": "Phone",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "id",
          "role",
          "phone"
        ],
        "title": "AuthenticatedUser",
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "description": "Stable machine-readable error identifier",
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Echoes X-Correlation-Id for support and tracing",
            "title": "Correlation Id"
          },
          "details": {
            "additionalProperties": true,
            "description": "Structured context",
            "title": "Details",
            "type": "object"
          },
          "field_errors": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "title": "Field Errors",
            "type": "array"
          },
          "message": {
            "description": "Human-readable description",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "Error",
        "type": "object"
      },
      "ErrorDetail": {
        "description": "A single field-level validation problem.",
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Machine-readable validation code",
            "title": "Code"
          },
          "field": {
            "description": "Dotted path to the offending field, e.g. 'items.0.quantity'",
            "title": "Field",
            "type": "string"
          },
          "message": {
            "description": "Human-readable explanation",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "description": "The platform-wide error response body.\n\nExample:\n    ```json\n    {\n      \"error\": {\n        \"code\": \"merchant_closed\",\n        \"message\": \"Merchant is not accepting orders right now\",\n        \"details\": {\"opens_at\": \"11:00\"},\n        \"field_errors\": [],\n        \"correlation_id\": \"01J9Z...\"\n      }\n    }\n    ```",
        "examples": [
          {
            "error": {
              "code": "not_found",
              "correlation_id": "01J9Z8XQF3K7M2P4R6T8V0W1Y3",
              "details": {},
              "field_errors": [],
              "message": "Merchant not found"
            }
          }
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "HealthStatus": {
        "description": "Health and readiness probe response.",
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Per-dependency status, e.g. {'database': 'ok'}",
            "title": "Checks",
            "type": "object"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "description": "'ok' or 'degraded'",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "environment"
        ],
        "title": "HealthStatus",
        "type": "object"
      },
      "LoginRequest": {
        "description": "Exchange a phone number and OTP for tokens.",
        "examples": [
          {
            "otp": "123456",
            "phone": "+971501234567"
          }
        ],
        "properties": {
          "otp": {
            "description": "The numeric OTP code",
            "maxLength": 8,
            "minLength": 4,
            "pattern": "^\\d+$",
            "title": "Otp",
            "type": "string"
          },
          "phone": {
            "description": "Phone number in E.164 or local format, e.g. '+971501234567' or '0501234567'",
            "examples": [
              "+971501234567"
            ],
            "maxLength": 24,
            "minLength": 6,
            "title": "Phone",
            "type": "string"
          }
        },
        "required": [
          "phone",
          "otp"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "LogoutRequest": {
        "description": "Revoke a session.\n\nSupply either the refresh token to revoke a single session, or ``all_sessions`` to\nrevoke every session belonging to the authenticated principal.",
        "properties": {
          "all_sessions": {
            "default": false,
            "title": "All Sessions",
            "type": "boolean"
          },
          "refresh_token": {
            "anyOf": [
              {
                "minLength": 20,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refresh Token"
          }
        },
        "title": "LogoutRequest",
        "type": "object"
      },
      "OtpChallengeResponse": {
        "description": "Details of an issued OTP challenge.",
        "properties": {
          "attempts_allowed": {
            "title": "Attempts Allowed",
            "type": "integer"
          },
          "challenge_id": {
            "description": "Identifier of the challenge, for support lookups",
            "title": "Challenge Id",
            "type": "string"
          },
          "debug_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The OTP itself. Only populated outside production, for local testing.",
            "title": "Debug Code"
          },
          "delivery_channel": {
            "description": "Channel used to deliver the code, e.g. 'sms'",
            "title": "Delivery Channel",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "phone": {
            "description": "Normalised E.164 phone the code was sent to",
            "title": "Phone",
            "type": "string"
          }
        },
        "required": [
          "challenge_id",
          "phone",
          "expires_at",
          "attempts_allowed",
          "delivery_channel"
        ],
        "title": "OtpChallengeResponse",
        "type": "object"
      },
      "OtpRequest": {
        "description": "Request a one-time password for a phone number.",
        "examples": [
          {
            "phone": "+971501234567"
          }
        ],
        "properties": {
          "phone": {
            "description": "Phone number in E.164 or local format, e.g. '+971501234567' or '0501234567'",
            "examples": [
              "+971501234567"
            ],
            "maxLength": 24,
            "minLength": 6,
            "title": "Phone",
            "type": "string"
          }
        },
        "required": [
          "phone"
        ],
        "title": "OtpRequest",
        "type": "object"
      },
      "RefreshRequest": {
        "description": "Exchange a refresh token for a new token pair.",
        "properties": {
          "refresh_token": {
            "description": "A valid refresh token",
            "minLength": 20,
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest",
        "type": "object"
      },
      "Role": {
        "description": "Platform roles. A user has exactly one primary role.\n\n``SERVICE`` is used for machine-to-machine calls (background workers, AI agents),\nwhich are authorized against an explicit scope list rather than a user role.",
        "enum": [
          "customer",
          "merchant",
          "courier",
          "admin",
          "service"
        ],
        "title": "Role",
        "type": "string"
      },
      "SessionSummary": {
        "description": "An active session belonging to the authenticated principal.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "ip_address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ip Address"
          },
          "is_current": {
            "default": false,
            "title": "Is Current",
            "type": "boolean"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "user_agent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Agent"
          }
        },
        "required": [
          "session_id",
          "created_at",
          "expires_at"
        ],
        "title": "SessionSummary",
        "type": "object"
      },
      "TokenPair": {
        "description": "The token pair issued on login and refresh.",
        "examples": [
          {
            "access_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
            "expires_in": 900,
            "refresh_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
            "token_type": "Bearer",
            "user": {
              "id": "usr_01J9Z8XQF3K7M2P4R6T8V0W1Y3",
              "name": "Layla",
              "phone": "+971501234567",
              "role": "customer"
            }
          }
        ],
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "description": "Access token lifetime in seconds",
            "title": "Expires In",
            "type": "integer"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "default": "Bearer",
            "title": "Token Type",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/AuthenticatedUser"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "expires_in",
          "user"
        ],
        "title": "TokenPair",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "JWT access token",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "\nPhone/OTP authentication and token lifecycle for the Marsool platform.\n\nThis is the only service that mints tokens; every other service verifies them\nindependently against the same issuer, audience and signing key.\n\n**Flow**\n\n1. `POST /auth/otp` \u2014 request a one-time password (rate limited per phone number).\n2. `POST /auth/login` \u2014 exchange the phone number and code for an access/refresh pair.\n   The account is created on first successful login.\n3. `POST /auth/refresh` \u2014 rotate the refresh token. Tokens are single-use; replaying a\n   rotated token revokes the whole session.\n4. `POST /auth/logout` \u2014 revoke one session or all sessions.\n",
    "title": "Marsool Auth Service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/login": {
      "post": {
        "description": "Verifies the one-time password and issues an access/refresh token pair. The account is created on first successful login. Invalid, expired and unknown codes all return the same 401 error code.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Malformed request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Missing or invalid credentials"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Caller lacks permission"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Resource not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Request validation failed"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Rate limit exceeded"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unexpected internal error"
          }
        },
        "summary": "Exchange a phone number and OTP for tokens",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "description": "Revokes the session behind the supplied refresh token, or every session for the authenticated user when `all_sessions` is true. Idempotent: revoking an unknown or already-revoked token succeeds.",
        "operationId": "logout",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Malformed request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Missing or invalid credentials"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Caller lacks permission"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Resource not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Request validation failed"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Rate limit exceeded"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unexpected internal error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Revoke one session or all sessions",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/otp": {
      "post": {
        "description": "Sends a one-time password to the given phone number and returns the challenge metadata. The response is identical whether or not the number is registered, so it cannot be used to enumerate accounts. Requests are rate limited per phone number; exceeding the limit returns 429 with a `Retry-After` header.",
        "operationId": "request_otp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OtpChallengeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Malformed request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Missing or invalid credentials"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Caller lacks permission"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Resource not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Request validation failed"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Rate limit exceeded"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unexpected internal error"
          }
        },
        "summary": "Request a one-time password",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "description": "Exchanges a refresh token for a new pair and invalidates the presented token. Reusing an already-rotated token revokes the entire session and returns 401.",
        "operationId": "refresh_token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Malformed request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Missing or invalid credentials"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Caller lacks permission"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Resource not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Request validation failed"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Rate limit exceeded"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unexpected internal error"
          }
        },
        "summary": "Rotate a refresh token",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/sessions": {
      "get": {
        "description": "Returns active, unexpired sessions newest first, flagging the current one.",
        "operationId": "list_sessions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SessionSummary"
                  },
                  "title": "Response List Sessions",
