# Copy to .env for local development. Every setting is read from the environment with a
# MARSOOL_ prefix so a shared container environment cannot collide with unrelated variables.
# Production values come from a secrets manager, never from a file.

MARSOOL_ENVIRONMENT=local
MARSOOL_LOG_LEVEL=INFO
MARSOOL_LOG_FORMAT=console

# Data stores
MARSOOL_DATABASE_DSN=postgresql+asyncpg://marsool:marsool@localhost:5432/marsool
MARSOOL_REDIS_DSN=redis://localhost:6379/0

# Event bus. "memory" keeps local development and tests hermetic; set "kafka" to exercise
# real cross-service event flow against the Compose stack's broker.
MARSOOL_EVENT_BUS_BACKEND=memory
MARSOOL_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Auth. HS256 with a shared secret is a local-development convenience; production uses RS256
# with a private key held only by the auth service.
MARSOOL_JWT_ALGORITHM=HS256
MARSOOL_JWT_SECRET=local-development-secret-change-me
MARSOOL_ACCESS_TOKEN_TTL_SECONDS=900
MARSOOL_REFRESH_TOKEN_TTL_SECONDS=2592000

# Rate limits
MARSOOL_RATE_LIMIT_ENABLED=true
MARSOOL_RATE_LIMIT_REQUESTS=120
MARSOOL_RATE_LIMIT_WINDOW_SECONDS=60

# Gateway upstreams
MARSOOL_AUTH_SERVICE_URL=http://localhost:8001
MARSOOL_USER_SERVICE_URL=http://localhost:8002
MARSOOL_MERCHANT_SERVICE_URL=http://localhost:8003
MARSOOL_CATALOG_SERVICE_URL=http://localhost:8004

# Web client origin for CORS
MARSOOL_CORS_ALLOW_ORIGINS=http://localhost:3000

# Returning the OTP in the API response is a local affordance and is refused in production
# regardless of this flag.
MARSOOL_OTP_ECHO_IN_RESPONSE=true
